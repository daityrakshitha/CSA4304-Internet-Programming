<!DOCTYPE html>
<html>
<head>
    <title>Beauty Parlour Appointment</title>

    <style>
        body {
            font-family: Arial;
            background-color: #fce4ec;
            margin: 0;
        }

        header {
            background-color: #d81b60;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background-color: #880e4f;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 20px;
            text-decoration: none;
        }

        .container {
            width: 80%;
            margin: 25px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        h2 {
            color: #d81b60;
        }

        input, select {
            width: 95%;
            padding: 10px;
            margin: 8px;
        }

        button {
            background-color: #d81b60;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
        }

        footer {
            background-color: #880e4f;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

<header>
    <h1>Beauty Bliss Parlour</h1>
    <p>Online Appointment Booking System</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Services</a>
    <a href="#">Stylists</a>
    <a href="#">Appointments</a>
    <a href="#">Contact</a>
</nav>

<div class="container">

    <h2>Our Services</h2>
    <ul>
        <li>Hair Cut - ₹300</li>
        <li>Hair Spa - ₹800</li>
        <li>Facial - ₹600</li>
        <li>Manicure - ₹400</li>
        <li>Bridal Makeup - ₹5000</li>
    </ul>

    <h2>Book Appointment</h2>

    <form>
        <label>Customer Name:</label>
        <input type="text" name="name">

        <label>Email:</label>
        <input type="email" name="email">

        <label>Select Service:</label>
        <select>
            <option>Hair Cut</option>
            <option>Hair Spa</option>
            <option>Facial</option>
            <option>Manicure</option>
            <option>Bridal Makeup</option>
        </select>

        <label>Select Stylist:</label>
        <select>
            <option>Priya</option>
            <option>Divya</option>
            <option>Swetha</option>
        </select>

        <label>Select Date:</label>
        <input type="date">

        <label>Select Time:</label>
        <input type="time">

        <label>Payment:</label>
        <select>
            <option>Full Payment</option>
            <option>Partial Deposit</option>
        </select>

        <br><br>
        <button type="submit">Book Appointment</button>
    </form>

    <h2>Customer Feedback</h2>
    <textarea rows="4" cols="60"
              placeholder="Enter your feedback"></textarea>

</div>

<footer>
    <p>© 2026 Beauty Bliss Parlour | All Rights Reserved</p>
</footer>

</body>
</html>
