<!DOCTYPE html>
<html>
<head>
<title>Train Reservation</title>
<style>
body{text-align:center;font-family:Arial;background:#eee}
.box{width:350px;margin:30px auto;padding:20px;background:white}
input,select{width:90%;padding:8px;margin:6px}
input[type=submit]{background:green;color:white;border:0}
.result{margin-top:15px;background:#e8ffe8;padding:10px;text-align:left}
</style>
</head>

<body>
<div class="box">
<h2>Train Reservation</h2>

<form>
<input type="text" placeholder="Passenger Name">
<input type="text" placeholder="From Station">
<input type="text" placeholder="To Station">
<input type="date">

<select>
<option>AC First Class</option>
<option>AC 2 Tier</option>
<option>Sleeper</option>
</select>

<input type="number" placeholder="No. of Passengers">
<input type="submit" value="Book Ticket">
</form>

<div class="result">
<b>Booking Details</b><br>
Train: Chennai Express<br>
From: Chennai<br>
To: Bangalore<br>
Class: Sleeper<br>
Seat: Available<br>
PNR: 4587210365
</div>

</div>
</body>
</html>
