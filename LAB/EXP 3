```html
<!DOCTYPE html>
<html>
<head>
    <title>Online Bus Ticket Booking</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            text-align: center;
        }

        .box {
            width: 400px;
            margin: 30px auto;
            padding: 20px;
            background: white;
            border: 1px solid gray;
            border-radius: 10px;
        }

        input, select {
            width: 90%;
            padding: 8px;
            margin: 7px;
        }

        input[type="submit"] {
            width: 50%;
            background: green;
            color: white;
            border: none;
        }

        .output {
            margin-top: 20px;
            padding: 15px;
            background: #e8ffe8;
            text-align: left;
        }
    </style>
</head>

<body>

<div class="box">

    <h2>Online Bus Ticket Booking</h2>

    <form>

        <input type="text" placeholder="Passenger Name">

        <input type="text" placeholder="From">

        <input type="text" placeholder="To">

        <input type="date">

        <select>
            <option>Volvo Bus</option>
            <option>Sleeper Bus</option>
            <option>Coach Bus</option>
        </select>

        <input type="number" placeholder="Number of Seats">

        <input type="submit" value="Book Ticket">

    </form>

    <div class="output">

        <h3>Booking Confirmation</h3>

        Passenger: Tejaswini<br>
        Route: Chennai → Bangalore<br>
        Date: 03-10-2026<br>
        Bus: Volvo Bus<br>
        Seats: 2<br>
        Total Amount: ₹1000

    </div>

</div>

</body>
</html>
