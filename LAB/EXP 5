<!DOCTYPE html>
<html>
<head>
<title>Flight Reservation</title>
<style>
body{text-align:center;font-family:Arial;background:#eee}
.box{width:350px;margin:30px auto;padding:20px;background:white}
input,select{width:90%;padding:8px;margin:6px}
input[type=submit]{background:blue;color:white;border:0}
.result{margin-top:15px;background:#e8f0ff;padding:10px;text-align:left}
</style>
</head>

<body>
<div class="box">
<h2>Flight Reservation</h2>

<form>
<input type="text" placeholder="Passenger Name">
<input type="text" placeholder="From">
<input type="text" placeholder="Destination">
<input type="date">

<select>
<option>Economy Class</option>
<option>Business Class</option>
</select>

<input type="number" placeholder="No. of Passengers">
<input type="submit" value="Book Flight">
</form>

<div class="result">
<b>Booking Details</b><br>
Flight: Air India<br>
From: Chennai<br>
To: Delhi<br>
Class: Economy<br>
Seat: Available<br>
Ticket No: AI458721
</div>

</div>
</body>
</html>
